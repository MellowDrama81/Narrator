@page "/connections"
@inject NarratorWorkspace Workspace

<header><p class="eyebrow">Providers</p><h1>API connections</h1><p class="lead">Each API key stays in secure device storage. Calls can use different saved connections.</p></header>
@if (_settings is null) { <p>Loading connections…</p> } else { <section class="actions"><button class="button" @onclick="Add">Add connection</button><button class="button primary" @onclick="Save">Save connections</button></section><section class="cards">@foreach (var item in _editors) { <article><label>Name<input @bind="item.Name" /></label><label>Base URL<input @bind="item.BaseUrl" placeholder="https://provider.example/v1" /></label><label>API key<input type="password" @bind="item.ApiKey" placeholder="Leave blank to preserve current key" /></label><label class="check"><input type="checkbox" @bind="item.ClearApiKey" /> Clear stored API key when saved</label><p class="hint">@item.Status</p><div class="actions"><button class="button" @onclick="() => Test(item)">Test connection</button><button class="button danger" @onclick="() => Remove(item)">Remove</button></div></article> }</section>@if (_message is not null) { <p class="status">@_message</p> } }
@code {
    private ApiConnectionSettings? _settings; private readonly List<ConnectionEdit> _editors = []; private string? _message;
    protected override async Task OnInitializedAsync() { _settings = await Workspace.SettingsAsync(); foreach (var p in _settings.Connections) _editors.Add(new(p, await Workspace.ConnectionCredentialAsync(p.Id))); if (_editors.Count == 0) Add(); }
    private void Add() => _editors.Add(new(new(Guid.NewGuid(), "New connection", null), null)); private void Remove(ConnectionEdit editor) => _editors.Remove(editor);
    private async Task<bool> Save() { if (_settings is null || _editors.Count == 0) { _message = "Keep at least one connection."; return false; } try { var profiles = _editors.Select(e => e.ToProfile()).ToArray(); if (profiles.Any(e => e.BaseUrl is null)) { _message = "Each connection needs an absolute http or https base URL."; return false; } var routes = _settings.GenerationCallRoutes.ToDictionary(x => x.Key, x => profiles.Any(p => p.Id == x.Value.ConnectionId) ? x.Value : x.Value with { ConnectionId = profiles[0].Id }); await Workspace.SaveSettingsAsync(_settings with { Connections = profiles, GenerationCallRoutes = routes }); foreach (var e in _editors) if (e.ClearApiKey || !string.IsNullOrWhiteSpace(e.ApiKey)) await Workspace.SaveConnectionCredentialAsync(e.Id, e.ClearApiKey ? null : e.ApiKey); _settings = await Workspace.SettingsAsync(); _message = "Connections saved."; return true; } catch (Exception ex) { _message = ex.Message; return false; } }
    private async Task Test(ConnectionEdit editor) { if (!await Save()) return; try { var result = await Workspace.TestConnectionAsync(editor.Id); editor.Status = result.Success ? $"Connected — {result.Capabilities.StructuredOutputTier}. {result.Models.Count} model(s) discovered." : result.Error ?? "Connection failed."; } catch (Exception ex) { editor.Status = ex.Message; } }
    private sealed class ConnectionEdit { public ConnectionEdit(ApiConnectionProfile value, string? apiKey) { Id=value.Id; Name=value.Name; BaseUrl=value.BaseUrl?.ToString() ?? ""; ApiKey=apiKey ?? ""; } public Guid Id { get; } public string Name { get; set; } public string BaseUrl { get; set; } public string ApiKey { get; set; } public bool ClearApiKey { get; set; } public string Status { get; set; } = "Not tested."; public ApiConnectionProfile ToProfile() => new(Id, Name.Trim(), Uri.TryCreate(BaseUrl.Trim(), UriKind.Absolute, out var value) ? value : null); }
}
