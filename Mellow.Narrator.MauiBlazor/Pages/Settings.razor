@page "/settings"
@inject NarratorWorkspace Workspace

<header><p class="eyebrow">Configuration</p><h1>Generation settings</h1><p class="lead">Select the pipeline and set shared request defaults. Per-call routes remain available in the native app while this page is expanded.</p></header>
@if (_settings is null) { <p>Loading settings…</p> } else { <section class="editor-card"><h2>Pipeline</h2><label>Turn pipeline<select @bind="_pipeline">@foreach (var mode in Enum.GetValues<TurnPipelineMode>()) { <option value="@mode">@Name(mode)</option> }</select></label><h2>Shared request behaviour</h2><label>Request timeout (seconds)<input type="number" @bind="_timeout" /></label><label>Maximum output tokens<input type="number" @bind="_maxTokens" /></label><label>Recent turns sent to the model<input type="number" @bind="_recentTurns" /></label><div class="actions"><button class="button primary" @onclick="Save">Save settings</button><a class="button" href="connections">Manage connections</a></div>@if (_message is not null) { <p class="status">@_message</p> }</section> }
@code { private ApiConnectionSettings? _settings; private TurnPipelineMode _pipeline; private int _timeout; private int _maxTokens; private int _recentTurns; private string? _message; protected override async Task OnInitializedAsync() { _settings=await Workspace.SettingsAsync(); _pipeline=_settings.TurnPipeline; _timeout=(int)_settings.RequestTimeout.TotalSeconds; _maxTokens=_settings.MaxOutputTokens; _recentTurns=_settings.StoryGeneration.RecentTurnCount; } private async Task Save() { if (_settings is null) return; try { _settings = _settings with { TurnPipeline=_pipeline, RequestTimeout=TimeSpan.FromSeconds(_timeout), MaxOutputTokens=_maxTokens, StoryGeneration=_settings.StoryGeneration with { RecentTurnCount=_recentTurns } }; await Workspace.SaveSettingsAsync(_settings); _message="Settings saved."; } catch (Exception ex) { _message=ex.Message; } } private static string Name(TurnPipelineMode mode) => string.Concat(mode.ToString().Select((c,i) => i > 0 && char.IsUpper(c) ? " " + c : c.ToString())); }
