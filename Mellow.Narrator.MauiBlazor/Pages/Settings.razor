@page "/settings"
@inject NarratorWorkspace Workspace

<header><p class="eyebrow">Configuration</p><h1>Generation settings</h1><p class="lead">Shared defaults, memory limits, content limits, retry behavior, and diagnostics.</p></header>
@if (_settings is null) { <p>Loading settings…</p> } else { <section class="editor-card"><h2>Story flow</h2><label>Turn pipeline<select @bind="_pipeline">@foreach (var mode in Enum.GetValues<TurnPipelineMode>()) { <option value="@mode">@Name(mode)</option> }</select></label><div class="actions"><a class="button" href="pipeline">Configure pipeline calls</a><a class="button" href="connections">Manage connections</a></div><h2>Shared request behavior</h2><Fields Values="_values" Items="RequestFields" /><h2>Context & memory</h2><Fields Values="_values" Items="MemoryFields" /><h2>Narration & player input</h2><Fields Values="_values" Items="NarrationFields" /><h2>Story structure</h2><Fields Values="_values" Items="StructureFields" /><h2>Advanced safety</h2><Fields Values="_values" Items="SafetyFields" /><h2>Diagnostics</h2><label>Log level<select @bind="_logLevel">@foreach (var level in Enum.GetValues<NarratorLogLevel>()) { <option value="@level">@level</option> }</select></label><p class="hint">Trace can contain story and player content. API credentials are never logged.</p><div class="actions"><button class="button primary" @onclick="Save">Save settings</button><button class="button danger" @onclick="Reset">Reset defaults</button></div>@if (_message is not null) { <p class="status">@_message</p> }</section> }
@code {
 private ApiConnectionSettings? _settings; private TurnPipelineMode _pipeline; private NarratorLogLevel _logLevel; private Dictionary<string,string> _values=[]; private string? _message;
 private static readonly Field[] RequestFields=[new("timeout","Request timeout seconds"),new("tokens","Maximum output tokens"),new("retries","Automatic retries"),new("retryInitial","Initial retry delay seconds"),new("retryMax","Maximum retry delay seconds"),new("retryAfter","Maximum Retry-After seconds")];
 private static readonly Field[] MemoryFields=[new("recent","Recent turns in context"),new("bibleEntries","Maximum Story Bible entries"),new("bibleEntryChars","Bible entry character limit"),new("bibleChars","Bible total character limit"),new("bibleWarning","Bible capacity warning percent"),new("eventEntries","Maximum planned events"),new("eventEntryChars","Planned Event entry character limit"),new("eventChars","Planned Event total character limit"),new("eventWarning","Planned Event warning percent"),new("summary","Story summary characters")];
 private static readonly Field[] NarrationFields=[new("action","Player action characters"),new("narration","Narration characters"),new("suggestedMin","Minimum suggested actions"),new("suggestedMax","Maximum suggested actions"),new("suggestedChars","Suggested action characters"),new("paragraphMin","Minimum paragraphs per response"),new("paragraphMax","Maximum paragraphs per response"),new("sentenceMin","Minimum sentences per paragraph"),new("sentenceMax","Maximum sentences per paragraph")];
 private static readonly Field[] StructureFields=[new("title","Title characters"),new("label","Story label characters"),new("prompt","Story Definition Prompt / Story Prompt characters"),new("category","Bible category characters"),new("name","Bible name characters"),new("bibleUpdates","Bible updates per response"),new("eventDescription","Planned Event description characters"),new("eventCondition","Planned Event condition characters"),new("eventUpdates","Planned Event updates per response"),new("conditions","Victory/Loss conditions per list"),new("conditionDescription","Condition description characters")]; private static readonly Field[] SafetyFields=[new("responseBytes","Maximum API response size (bytes)")];
 protected override async Task OnInitializedAsync(){_settings=await Workspace.SettingsAsync();Load(_settings);} private void Load(ApiConnectionSettings s){_pipeline=s.TurnPipeline;_logLevel=s.Logging.MinimumLevel;var g=s.StoryGeneration;var c=s.ContentLimits;_values=new(){["timeout"]=$"{s.RequestTimeout.TotalSeconds:0}",["tokens"]=$"{s.MaxOutputTokens}",["retries"]=$"{s.Retry.MaxAutomaticRetries}",["retryInitial"]=$"{s.Retry.InitialDelay.TotalSeconds:0.##}",["retryMax"]=$"{s.Retry.MaxDelay.TotalSeconds:0.##}",["retryAfter"]=$"{s.Retry.MaxRetryAfter.TotalSeconds:0}",["recent"]=$"{g.RecentTurnCount}",["bibleEntries"]=$"{g.MaxStoryBibleEntries}",["bibleEntryChars"]=$"{g.MaxStoryBibleEntryCharacters}",["bibleChars"]=$"{g.MaxStoryBibleCharacters}",["bibleWarning"]=$"{g.StoryBibleWarningPercent}",["eventEntries"]=$"{g.MaxPlannedEvents}",["eventEntryChars"]=$"{g.MaxPlannedEventCharacters}",["eventChars"]=$"{g.MaxPlannedEventsCharacters}",["eventWarning"]=$"{g.PlannedEventsWarningPercent}",["summary"]=$"{c.MaxStorySummaryCharacters}",["action"]=$"{c.MaxPlayerActionCharacters}",["narration"]=$"{c.MaxNarrationCharacters}",["suggestedMin"]=$"{c.MinSuggestedActions}",["suggestedMax"]=$"{c.MaxSuggestedActions}",["suggestedChars"]=$"{c.MaxSuggestedActionCharacters}",["paragraphMin"]=$"{c.MinParagraphsPerResponse}",["paragraphMax"]=$"{c.MaxParagraphsPerResponse}",["sentenceMin"]=$"{c.MinSentencesPerParagraph}",["sentenceMax"]=$"{c.MaxSentencesPerParagraph}",["title"]=$"{c.MaxStoryTitleCharacters}",["label"]=$"{c.MaxStoryLabelCharacters}",["prompt"]=$"{c.MaxStoryPromptCharacters}",["category"]=$"{c.MaxStoryBibleCategoryCharacters}",["name"]=$"{c.MaxStoryBibleNameCharacters}",["bibleUpdates"]=$"{c.MaxStoryBibleUpdatesPerResponse}",["eventDescription"]=$"{c.MaxPlannedEventDescriptionCharacters}",["eventCondition"]=$"{c.MaxPlannedEventConditionCharacters}",["eventUpdates"]=$"{c.MaxPlannedEventUpdatesPerResponse}",["conditions"]=$"{c.MaxConditions}",["conditionDescription"]=$"{c.MaxConditionDescriptionCharacters}",["responseBytes"]=$"{c.MaxResponseBodyBytes}"};}
 private int I(string key)=>int.Parse(_values[key],System.Globalization.CultureInfo.InvariantCulture);private double D(string key)=>double.Parse(_values[key],System.Globalization.CultureInfo.InvariantCulture);
 private async Task Save(){if(_settings is null)return;try{var c=_settings.ContentLimits;var next=_settings with{TurnPipeline=_pipeline,RequestTimeout=TimeSpan.FromSeconds(D("timeout")),MaxOutputTokens=I("tokens"),Retry=new(I("retries"),TimeSpan.FromSeconds(D("retryInitial")),TimeSpan.FromSeconds(D("retryMax")),TimeSpan.FromSeconds(D("retryAfter"))),Logging=new(_logLevel),StoryGeneration=new(I("recent"),I("bibleEntries"),I("bibleEntryChars"),I("bibleChars"),I("bibleWarning"),I("eventEntries"),I("eventEntryChars"),I("eventChars"),I("eventWarning")),ContentLimits=new(I("title"),I("label"),I("prompt"),I("action"),I("narration"),I("suggestedMax"),I("suggestedChars"),I("category"),I("name"),I("bibleUpdates"),I("eventDescription"),I("eventCondition"),I("eventUpdates"),I("conditions"),I("conditionDescription"),I("summary"),I("responseBytes")){MinSuggestedActions=I("suggestedMin"),MinParagraphsPerResponse=I("paragraphMin"),MaxParagraphsPerResponse=I("paragraphMax"),MinSentencesPerParagraph=I("sentenceMin"),MaxSentencesPerParagraph=I("sentenceMax")}};await Workspace.SaveSettingsAsync(next);_settings=next;_message="Settings saved.";}catch(Exception ex){_message=ex.Message;}}
 private void Reset(){var defaults=NarratorDefaults.Create();if(_settings is not null)defaults=defaults with{Connections=_settings.Connections,GenerationCallRoutes=_settings.GenerationCallRoutes,BaseUrl=_settings.BaseUrl,ModelId=_settings.ModelId,Capabilities=_settings.Capabilities};_settings=defaults;Load(defaults);_message="Defaults loaded. Save to apply them.";}private static string Name(TurnPipelineMode mode)=>string.Concat(mode.ToString().Select((c,i)=>i>0&&char.IsUpper(c)?" "+c:c.ToString())); public sealed record Field(string Key,string Label);
}
