@page "/stories"
@inject NarratorWorkspace Workspace
@inject NavigationManager Navigation
@inject ImportExportService ImportExport
@inject IJSRuntime JS

<header><p class="eyebrow">Play</p><h1>Stories</h1><p class="lead">Resume, rename, copy, reorder, import, or archive any playthrough.</p></header><div class="actions"><button class="button" @onclick="Import">Import story</button></div>
@if (_items is null) { <p>Loading stories…</p> } else if (_items.Count == 0) { <div class="empty">No stories in progress. Start one from a definition.</div> } else { <section class="cards">@for (var index = 0; index < _items.Count; index++) { var item = _items[index]; var position = index; <article><h2>@item.Label</h2><p>Last played: @(item.LastActionAtUtc?.ToLocalTime().ToString("g") ?? "not yet")</p>@if (_renamingId == item.Id) { <div class="actions"><input @bind="_newLabel" /><button class="button primary" @onclick="SaveRename">Save</button><button class="button" @onclick="CancelRename">Cancel</button></div> }<div class="actions"><a class="button" href="story/@item.Id">Resume</a><button class="button" @onclick="() => Rename(item)">Rename</button><button class="button" @onclick="() => Copy(item.Id)">Copy</button><button class="button" disabled="@(position == 0)" @onclick="() => Move(position, -1)">Earlier</button><button class="button" disabled="@(position == _items.Count - 1)" @onclick="() => Move(position, 1)">Later</button><button class="button danger" @onclick="() => Delete(item.Id)">Trash</button></div></article> }</section> }
@code { private IReadOnlyList<StoryStateSummary>? _items; private Guid? _renamingId; private string _newLabel = ""; protected override async Task OnInitializedAsync() => await Refresh(); private async Task Refresh() => _items = await Workspace.StoriesAsync(); private async Task Copy(Guid id) { var copy = await Workspace.CopyStoryAsync(id); Navigation.NavigateTo($"story/{copy.Id}"); } private async Task Delete(Guid id) { if (!await JS.InvokeAsync<bool>("confirm", "Move this complete story to Trash?")) return; await Workspace.DeleteStoryAsync(id); await Refresh(); } private async Task Move(int index, int delta) { if (_items is null || index + delta < 0 || index + delta >= _items.Count) return; await Workspace.SwapStoryOrderAsync(_items[index].Id, _items[index + delta].Id); await Refresh(); } private async Task Import() { var value = await ImportExport.ImportStoryAsync(); if (value is not null) Navigation.NavigateTo($"story/{value.Id}"); } private void Rename(StoryStateSummary item) { _renamingId = item.Id; _newLabel = item.Label; } private async Task SaveRename() { if (_renamingId is not { } id || string.IsNullOrWhiteSpace(_newLabel)) return; await Workspace.UpdateStoryLabelAsync(id, _newLabel); _renamingId = null; await Refresh(); } private void CancelRename() => _renamingId = null; }
