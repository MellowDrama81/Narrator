@page "/definition/{Id:guid}"
@inject NarratorWorkspace Workspace
@inject NavigationManager Navigation

@if (_definition is null) { <p>Loading definition…</p> } else { <header><p class="eyebrow">Story definition</p><h1>@_definition.Title</h1><p class="lead">@(_definition.StoryPrompt.Length == 0 ? "A blank definition, ready for your ideas." : _definition.StoryPrompt)</p></header><section class="metrics"><article><strong>@_definition.InitialStoryBible.Entries.Count</strong><span>Story Bible entries</span></article><article><strong>@_definition.InitialPlannedEvents.Entries.Count</strong><span>Planned events</span></article><article><strong>@(_definition.InitialVictoryConditions.Entries.Count + _definition.InitialLossConditions.Entries.Count)</strong><span>End conditions</span></article></section><button class="button primary" @onclick="Start">Start this story</button> }
@code { [Parameter] public Guid Id { get; set; } private StoryDefinition? _definition; protected override async Task OnParametersSetAsync() => _definition = await Workspace.DefinitionAsync(Id); private async Task Start() { if (_definition is null) return; var state = await Workspace.StartAsync(new StartStoryDraft(_definition.Id, new(_definition.Title, _definition.StoryPrompt, _definition.InitialEventsPrompt, _definition.InitialStoryBible, _definition.InitialPlannedEvents, _definition.InitialVictoryConditions, _definition.InitialLossConditions)), Guid.NewGuid()); Navigation.NavigateTo($"story/{state.State.Id}"); } }
