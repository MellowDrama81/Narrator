@page "/definition/{Id:guid}"
@inject NarratorWorkspace Workspace
@inject NavigationManager Navigation
@inject ImportExportService ImportExport

@if (_definition is null) { <p>Loading definition…</p> }
else {
<header><p class="eyebrow">Story definition</p><h1>Definition editor</h1><p class="lead">The definition contains all starting data. Its Story Prompt is only the enduring narration context.</p></header>
<section class="editor-card"><h2>Core</h2><label>Title<input @bind="_definition.Title" /></label><label>Story Prompt<textarea @bind="_definition.StoryPrompt"></textarea></label><label>Initial Events Prompt<textarea @bind="_definition.InitialEventsPrompt"></textarea></label><div class="actions"><button class="button primary" @onclick="SaveCore">Save Definition</button><button class="button" @onclick="Start" disabled="@NeedsCull">Start story</button><button class="button" @onclick="Export">Export</button></div></section>
@if (_settings is not null) { <section class="editor-card"><h2>Safety and maintenance</h2><p class="hint">Story Bible: @LimitStatus(StoryBibleProcessor.IsWithinLimits(_definition.InitialStoryBible, _settings.StoryGeneration)); Planned events: @LimitStatus(PlannedEventProcessor.IsWithinLimits(_definition.InitialPlannedEvents, _settings.StoryGeneration)).</p>@if (NeedsCull) { <p class="error">Starting is paused until the memory fits the configured limits.</p><div class="actions"><button class="button danger" @onclick="Cull">Cull to configured limits</button><a class="button" href="settings">Increase limits</a></div> }</section> }
<section class="editor-card"><h2>Story Bible</h2><p class="hint">Known and secret facts are entered one per line.</p><label>Filter entries<input @bind="_bibleFilter" placeholder="Name, category, or fact" /></label>@foreach (var item in FilterBible(_definition.InitialStoryBible.Entries)) { <details><summary>@item.Name <small>(importance @item.Importance)</small></summary><label>Category<input @bind="_bibleEdits[item.Id].Category" /></label><label>Name<input @bind="_bibleEdits[item.Id].Name" /></label><label>Known facts<textarea @bind="_bibleEdits[item.Id].Known"></textarea></label><label>Secret facts<textarea @bind="_bibleEdits[item.Id].Secret"></textarea></label><label>Importance<input type="number" min="1" max="5" @bind="_bibleEdits[item.Id].Importance" /></label><div class="actions"><button class="button" @onclick="() => SaveBibleItem(item.Id)">Save item</button><button class="button danger" @onclick="() => RemoveBibleItem(item.Id)">Remove</button></div></details> }<details><summary>Add Story Bible entry</summary><label>Category<input @bind="_newBible.Category" /></label><label>Name<input @bind="_newBible.Name" /></label><label>Known facts<textarea @bind="_newBible.Known"></textarea></label><label>Secret facts<textarea @bind="_newBible.Secret"></textarea></label><button class="button" @onclick="AddBibleItem">Add entry</button></details></section>
<section class="editor-card"><h2>Planned events</h2><p class="hint">Future plot points remain secret. An event cannot happen until its condition is true.</p><label>Filter events<input @bind="_eventFilter" placeholder="Description or condition" /></label>@foreach (var item in FilterEvents(_definition.InitialPlannedEvents.Entries)) { <details><summary>@item.Description <small>(importance @item.Importance, urgency @item.Urgency)</small></summary><label>Description<textarea @bind="_eventEdits[item.Id].Description"></textarea></label><label>Condition<textarea @bind="_eventEdits[item.Id].Condition"></textarea></label><label>Importance<input type="number" min="1" max="5" @bind="_eventEdits[item.Id].Importance" /></label><label>Urgency<input type="number" min="1" max="5" @bind="_eventEdits[item.Id].Urgency" /></label><div class="actions"><button class="button" @onclick="() => SaveEvent(item.Id)">Save event</button><button class="button danger" @onclick="() => RemoveEvent(item.Id)">Remove</button></div></details> }<details><summary>Add planned event</summary><label>Description<textarea @bind="_newEvent.Description"></textarea></label><label>Condition<textarea @bind="_newEvent.Condition"></textarea></label><button class="button" @onclick="AddEvent">Add event</button></details></section>
<Conditions Title="Victory conditions" Values="_definition.InitialVictoryConditions" OnSave="SaveVictory" />
<Conditions Title="Loss conditions" Values="_definition.InitialLossConditions" OnSave="SaveLoss" />
@if (_status is not null) { <p class="status">@_status</p> }
}
@code {
    [Parameter] public Guid Id { get; set; }
    private StoryDefinition? _definition; private ApiConnectionSettings? _settings; private string? _status; private string _bibleFilter = "", _eventFilter = "";
    private readonly Dictionary<Guid, BibleEdit> _bibleEdits = []; private readonly Dictionary<Guid, EventEdit> _eventEdits = [];
    private BibleEdit _newBible = new(); private EventEdit _newEvent = new();
    protected override async Task OnParametersSetAsync() { _definition = await Workspace.DefinitionAsync(Id); _settings = await Workspace.SettingsAsync(); if (_definition is not null) { _bibleEdits.Clear(); _eventEdits.Clear(); foreach (var e in _definition.InitialStoryBible.Entries) _bibleEdits[e.Id] = new(e); foreach (var e in _definition.InitialPlannedEvents.Entries) _eventEdits[e.Id] = new(e); } }
    private async Task SaveCore() { if (_definition is null) return; _definition = _definition with { UpdatedAtUtc = DateTimeOffset.UtcNow }; await Workspace.SaveDefinitionAsync(_definition); _status = "Definition saved."; }
    private async Task Start() { if (_definition is null) return; var state = await Workspace.StartAsync(new(_definition.Id, new(_definition.Title, _definition.StoryPrompt, _definition.InitialEventsPrompt, _definition.InitialStoryBible, _definition.InitialPlannedEvents, _definition.InitialVictoryConditions, _definition.InitialLossConditions)), Guid.NewGuid()); Navigation.NavigateTo($"story/{state.State.Id}"); }
    private Task Export() => _definition is null ? Task.CompletedTask : ImportExport.ExportDefinitionAsync(_definition);
    private bool NeedsCull => _definition is not null && _settings is not null && (!StoryBibleProcessor.IsWithinLimits(_definition.InitialStoryBible, _settings.StoryGeneration) || !PlannedEventProcessor.IsWithinLimits(_definition.InitialPlannedEvents, _settings.StoryGeneration));
    private static string LimitStatus(bool withinLimits) => withinLimits ? "within configured limits" : "over configured limits";
    private async Task Cull() { _definition = await Workspace.CullDefinitionAsync(Id); await OnParametersSetAsync(); _status = "The definition was culled to its configured limits."; }
    private async Task SaveBibleItem(Guid id) { if (_definition is null || !_bibleEdits.TryGetValue(id, out var edit)) return; var entries = _definition.InitialStoryBible.Entries.Select(e => e.Id == id ? edit.ToEntry(e.Id, e.LastRelevantTurnNumber) : e).ToArray(); _definition = await Workspace.SaveDefinitionBibleAsync(Id, new(entries)); await OnParametersSetAsync(); }
    private async Task RemoveBibleItem(Guid id) { if (_definition is null) return; _definition = await Workspace.SaveDefinitionBibleAsync(Id, new(_definition.InitialStoryBible.Entries.Where(e => e.Id != id).ToArray())); await OnParametersSetAsync(); }
    private async Task AddBibleItem() { if (_definition is null) return; _definition = await Workspace.SaveDefinitionBibleAsync(Id, new(_definition.InitialStoryBible.Entries.Append(_newBible.ToEntry(Guid.NewGuid(), 0)).ToArray())); _newBible = new(); await OnParametersSetAsync(); }
    private async Task SaveEvent(Guid id) { if (_definition is null || !_eventEdits.TryGetValue(id, out var edit)) return; _definition = await Workspace.SaveDefinitionEventsAsync(Id, new(_definition.InitialPlannedEvents.Entries.Select(e => e.Id == id ? edit.ToEvent(e.Id, e.LastRelevantTurnNumber) : e).ToArray())); await OnParametersSetAsync(); }
    private async Task RemoveEvent(Guid id) { if (_definition is null) return; _definition = await Workspace.SaveDefinitionEventsAsync(Id, new(_definition.InitialPlannedEvents.Entries.Where(e => e.Id != id).ToArray())); await OnParametersSetAsync(); }
    private async Task AddEvent() { if (_definition is null) return; _definition = await Workspace.SaveDefinitionEventsAsync(Id, new(_definition.InitialPlannedEvents.Entries.Append(_newEvent.ToEvent(Guid.NewGuid(), 0)).ToArray())); _newEvent = new(); await OnParametersSetAsync(); }
    private Task SaveVictory(StoryConditions value) => SaveConditions(value, true); private Task SaveLoss(StoryConditions value) => SaveConditions(value, false);
    private async Task SaveConditions(StoryConditions value, bool victory) { _definition = victory ? await Workspace.SaveDefinitionVictoryConditionsAsync(Id, value) : await Workspace.SaveDefinitionLossConditionsAsync(Id, value); await OnParametersSetAsync(); }
    private sealed class BibleEdit { public string Category { get; set; } = "World"; public string Name { get; set; } = ""; public string Known { get; set; } = ""; public string Secret { get; set; } = ""; public int Importance { get; set; } = 3; public BibleEdit() {} public BibleEdit(StoryBibleEntry e) { Category=e.Category; Name=e.Name; Known=string.Join('\n',e.KnownFacts); Secret=string.Join('\n',e.SecretFacts); Importance=e.Importance; } public StoryBibleEntry ToEntry(Guid id,int turn) => new(id,Category,Name,Lines(Known),Lines(Secret),Importance,turn); }
    private sealed class EventEdit { public string Description { get; set; } = ""; public string? Condition { get; set; } public int Importance { get; set; } = 3; public int Urgency { get; set; } = 3; public EventEdit() {} public EventEdit(PlannedEvent e) { Description=e.Description; Condition=e.Condition; Importance=e.Importance; Urgency=e.Urgency; } public PlannedEvent ToEvent(Guid id,int turn) => new(id,Description,Importance,Urgency,Condition,turn); }
    private static IReadOnlyList<string> Lines(string value) => value.Split('\n', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
    private IEnumerable<StoryBibleEntry> FilterBible(IEnumerable<StoryBibleEntry> values) => values.Where(x => string.IsNullOrWhiteSpace(_bibleFilter) || $"{x.Name} {x.Category} {string.Join(' ', x.KnownFacts)} {string.Join(' ', x.SecretFacts)}".Contains(_bibleFilter, StringComparison.OrdinalIgnoreCase)).OrderByDescending(x => x.Importance);
    private IEnumerable<PlannedEvent> FilterEvents(IEnumerable<PlannedEvent> values) => values.Where(x => string.IsNullOrWhiteSpace(_eventFilter) || $"{x.Description} {x.Condition}".Contains(_eventFilter, StringComparison.OrdinalIgnoreCase)).OrderByDescending(x => x.Importance).ThenByDescending(x => x.Urgency);
}
