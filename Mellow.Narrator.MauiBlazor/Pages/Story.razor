@page "/story/{Id:guid}"
@inject NarratorWorkspace Workspace

<header><p class="eyebrow">Interactive story</p><h1>@_story?.Label</h1></header>
@if (_turns is null) { <p>Loading story…</p> } else { <section class="transcript">@foreach (var turn in _turns) { <article class="turn"><p>@turn.Narration</p>@if (turn.SuggestedActions.Count > 0) { <div class="chips">@foreach (var action in turn.SuggestedActions) { <button @onclick="() => _action = action">@action</button> }</div>}</article> }</section><form @onsubmit="Play" @onsubmit:preventDefault="true"><textarea @bind="_action" placeholder="What do you do next?"></textarea><button class="button primary" disabled="@_busy">@(_busy ? "Writing…" : "Continue")</button></form> }
@code { [Parameter] public Guid Id { get; set; } private StoryState? _story; private IReadOnlyList<StoryTurn>? _turns; private string _action = ""; private bool _busy; protected override async Task OnParametersSetAsync() { _story = await Workspace.StoryAsync(Id); _turns = await Workspace.TurnsAsync(Id); } private async Task Play() { if (string.IsNullOrWhiteSpace(_action)) return; _busy = true; try { await Workspace.PlayAsync(Id, _action); _action = ""; _turns = await Workspace.TurnsAsync(Id); } finally { _busy = false; } } }
