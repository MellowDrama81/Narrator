@page "/story/{Id:guid}"
@inject NarratorWorkspace Workspace
@inject ImportExportService ImportExport

<header><p class="eyebrow">Interactive story</p><h1>@_story?.Label</h1>@if (_story is not null) { <div class="actions"><button class="button" @onclick="Export">Export story</button><button class="button" @onclick="ExportNarration">Export narration history</button><button class="button" @onclick="ExportBibleHistory">Export Bible history</button><button class="button" @onclick="ExportEventHistory">Export event history</button></div> }</header>
@if (_turns is null || _story is null) { <p>Loading story…</p> }
else {
@if (_settings is not null) { <section class="editor-card"><h2>Safety and maintenance</h2><p class="hint">Story Bible: @LimitStatus(StoryBibleProcessor.IsWithinLimits(_story.CurrentStoryBible, _settings.StoryGeneration)); Planned events: @LimitStatus(PlannedEventProcessor.IsWithinLimits(_story.CurrentPlannedEvents, _settings.StoryGeneration)).</p>@if (NeedsCull) { <p class="error">This live story exceeds the configured memory limits. Cull it before continuing, or increase the limits in settings.</p><button class="button danger" @onclick="Cull">Cull to configured limits</button> }</section> }
<details class="editor-card"><summary>Story state editor</summary>
  <label>Story label<input @bind="_label" /></label><button class="button" @onclick="SaveLabel">Save label</button>
  <label>Story summary<textarea @bind="_summary"></textarea></label><button class="button" @onclick="SaveSummary">Save summary</button>
  <h3>Current Story Bible</h3><p class="hint">Known and secret facts are one per line.</p>
  @foreach (var item in _story.CurrentStoryBible.Entries) { <details><summary>@item.Name <small>(importance @item.Importance)</small></summary><label>Category<input @bind="_bibleEdits[item.Id].Category" /></label><label>Name<input @bind="_bibleEdits[item.Id].Name" /></label><label>Known facts<textarea @bind="_bibleEdits[item.Id].Known"></textarea></label><label>Secret facts<textarea @bind="_bibleEdits[item.Id].Secret"></textarea></label><label>Importance<input type="number" min="1" max="5" @bind="_bibleEdits[item.Id].Importance" /></label><div class="actions"><button class="button" @onclick="() => SaveBible(item.Id)">Save entry</button><button class="button danger" @onclick="() => RemoveBible(item.Id)">Remove</button></div></details> }
  <details><summary>Add Story Bible entry</summary><label>Category<input @bind="_newBible.Category" /></label><label>Name<input @bind="_newBible.Name" /></label><label>Known facts<textarea @bind="_newBible.Known"></textarea></label><label>Secret facts<textarea @bind="_newBible.Secret"></textarea></label><button class="button" @onclick="AddBible">Add entry</button></details>
  <h3>Current planned events</h3><p class="hint">Conditions prevent an event from being pursued until satisfied.</p>
  @foreach (var item in _story.CurrentPlannedEvents.Entries) { <details><summary>@item.Description <small>(importance @item.Importance, urgency @item.Urgency)</small></summary><label>Description<textarea @bind="_eventEdits[item.Id].Description"></textarea></label><label>Condition<textarea @bind="_eventEdits[item.Id].Condition"></textarea></label><label>Importance<input type="number" min="1" max="5" @bind="_eventEdits[item.Id].Importance" /></label><label>Urgency<input type="number" min="1" max="5" @bind="_eventEdits[item.Id].Urgency" /></label><div class="actions"><button class="button" @onclick="() => SaveEvent(item.Id)">Save event</button><button class="button danger" @onclick="() => RemoveEvent(item.Id)">Remove</button></div></details> }
  <details><summary>Add planned event</summary><label>Description<textarea @bind="_newEvent.Description"></textarea></label><label>Condition<textarea @bind="_newEvent.Condition"></textarea></label><label>Importance<input type="number" min="1" max="5" @bind="_newEvent.Importance" /></label><label>Urgency<input type="number" min="1" max="5" @bind="_newEvent.Urgency" /></label><button class="button" @onclick="AddEvent">Add event</button></details>
  <h3>Outcome conditions</h3><ul>@foreach (var condition in _story.CurrentVictoryConditions.Entries) { <li>Victory: @condition.Description — @ConditionStatus(condition.Id, _story.RevealedVictoryConditionIds, _story.MetVictoryConditionIds)</li> }@foreach (var condition in _story.CurrentLossConditions.Entries) { <li>Loss: @condition.Description — @ConditionStatus(condition.Id, _story.RevealedLossConditionIds, _story.MetLossConditionIds)</li> }</ul>
  @if (_status is not null) { <p class="status">@_status</p> }
</details>
<section class="transcript">@foreach (var turn in _turns) { <article class="turn"><p>@turn.Narration</p>@if (turn.SuggestedActions.Count > 0) { <div class="chips">@foreach (var action in turn.SuggestedActions) { <button @onclick="() => _action = action">@action</button> }</div>}</article> }</section>
<form @onsubmit="Play" @onsubmit:preventDefault="true"><textarea @bind="_action" placeholder="What do you do next?"></textarea><button class="button primary" disabled="@_busy">@(_busy ? "Writing…" : "Continue")</button></form>
}
@code {
 [Parameter] public Guid Id { get; set; } private StoryState? _story; private ApiConnectionSettings? _settings; private IReadOnlyList<StoryTurn>? _turns; private string _action="", _summary="", _label=""; private string? _status; private bool _busy; private readonly Dictionary<Guid, BibleEdit> _bibleEdits=[]; private readonly Dictionary<Guid, EventEdit> _eventEdits=[]; private BibleEdit _newBible=new(); private EventEdit _newEvent=new();
 protected override async Task OnParametersSetAsync() { _story=await Workspace.StoryAsync(Id); _settings=await Workspace.SettingsAsync(); _turns=await Workspace.TurnsAsync(Id); if (_story is null) return; _summary=_story.StorySummary; _label=_story.Label; _bibleEdits.Clear(); _eventEdits.Clear(); foreach(var e in _story.CurrentStoryBible.Entries)_bibleEdits[e.Id]=new(e); foreach(var e in _story.CurrentPlannedEvents.Entries)_eventEdits[e.Id]=new(e); }
 private async Task Play(){if(string.IsNullOrWhiteSpace(_action))return;_busy=true;try{await Workspace.PlayAsync(Id,_action);_action="";await OnParametersSetAsync();}catch(Exception ex){_status=ex.Message;}finally{_busy=false;}}
 private async Task SaveLabel(){try{await Workspace.UpdateStoryLabelAsync(Id,_label);await OnParametersSetAsync();_status="Label saved.";}catch(Exception ex){_status=ex.Message;}}
 private async Task SaveSummary(){try{_story=await Workspace.SaveStorySummaryAsync(Id,_summary);_status="Summary saved.";}catch(Exception ex){_status=ex.Message;}}
 private async Task SaveBible(Guid id){if(_story is null)return;try{var entries=_story.CurrentStoryBible.Entries.Select(e=>e.Id==id?_bibleEdits[id].ToEntry(e.Id,e.LastRelevantTurnNumber):e).ToArray();_story=await Workspace.SaveStoryBibleAsync(Id,new(entries));await OnParametersSetAsync();}catch(Exception ex){_status=ex.Message;}}
 private async Task RemoveBible(Guid id){if(_story is null)return;try{_story=await Workspace.SaveStoryBibleAsync(Id,new(_story.CurrentStoryBible.Entries.Where(e=>e.Id!=id).ToArray()));await OnParametersSetAsync();}catch(Exception ex){_status=ex.Message;}}
 private async Task AddBible(){if(_story is null)return;try{_story=await Workspace.SaveStoryBibleAsync(Id,new(_story.CurrentStoryBible.Entries.Append(_newBible.ToEntry(Guid.NewGuid(),_story.LastCommittedTurnSequence)).ToArray()));_newBible=new();await OnParametersSetAsync();}catch(Exception ex){_status=ex.Message;}}
 private async Task SaveEvent(Guid id){if(_story is null)return;try{var entries=_story.CurrentPlannedEvents.Entries.Select(e=>e.Id==id?_eventEdits[id].ToEvent(e.Id,e.LastRelevantTurnNumber):e).ToArray();_story=await Workspace.SaveStoryEventsAsync(Id,new(entries));await OnParametersSetAsync();}catch(Exception ex){_status=ex.Message;}}
 private async Task RemoveEvent(Guid id){if(_story is null)return;try{_story=await Workspace.SaveStoryEventsAsync(Id,new(_story.CurrentPlannedEvents.Entries.Where(e=>e.Id!=id).ToArray()));await OnParametersSetAsync();}catch(Exception ex){_status=ex.Message;}}
 private async Task AddEvent(){if(_story is null)return;try{_story=await Workspace.SaveStoryEventsAsync(Id,new(_story.CurrentPlannedEvents.Entries.Append(_newEvent.ToEvent(Guid.NewGuid(),_story.LastCommittedTurnSequence)).ToArray()));_newEvent=new();await OnParametersSetAsync();}catch(Exception ex){_status=ex.Message;}}
 private Task Export()=>_story is null?Task.CompletedTask:ImportExport.ExportStoryAsync(_story); private Task ExportNarration()=>_story is null?Task.CompletedTask:ImportExport.ExportNarrationHistoryAsync(_story); private Task ExportBibleHistory()=>_story is null?Task.CompletedTask:ImportExport.ExportBibleHistoryAsync(_story); private Task ExportEventHistory()=>_story is null?Task.CompletedTask:ImportExport.ExportPlannedEventHistoryAsync(_story); private bool NeedsCull=>_story is not null&&_settings is not null&&(!StoryBibleProcessor.IsWithinLimits(_story.CurrentStoryBible,_settings.StoryGeneration)||!PlannedEventProcessor.IsWithinLimits(_story.CurrentPlannedEvents,_settings.StoryGeneration));private static string LimitStatus(bool within)=>within?"within configured limits":"over configured limits";private async Task Cull(){_story=await Workspace.CullStoryAsync(Id);await OnParametersSetAsync();_status="The story was culled to its configured limits.";} private static string ConditionStatus(Guid id,IReadOnlyList<Guid> revealed,IReadOnlyList<Guid> met)=>met.Contains(id)?"met":revealed.Contains(id)?"revealed":"unrevealed"; private sealed class BibleEdit{public string Category{get;set;}="World";public string Name{get;set;}="";public string Known{get;set;}="";public string Secret{get;set;}="";public int Importance{get;set;}=3;public BibleEdit(){}public BibleEdit(StoryBibleEntry e){Category=e.Category;Name=e.Name;Known=string.Join('\n',e.KnownFacts);Secret=string.Join('\n',e.SecretFacts);Importance=e.Importance;}public StoryBibleEntry ToEntry(Guid id,int turn)=>new(id,Category,Name,Lines(Known),Lines(Secret),Importance,turn);}private sealed class EventEdit{public string Description{get;set;}="";public string? Condition{get;set;}public int Importance{get;set;}=3;public int Urgency{get;set;}=3;public EventEdit(){}public EventEdit(PlannedEvent e){Description=e.Description;Condition=e.Condition;Importance=e.Importance;Urgency=e.Urgency;}public PlannedEvent ToEvent(Guid id,int turn)=>new(id,Description,Importance,Urgency,Condition,turn);}private static IReadOnlyList<string> Lines(string value)=>value.Split('\n',StringSplitOptions.TrimEntries|StringSplitOptions.RemoveEmptyEntries);
}
