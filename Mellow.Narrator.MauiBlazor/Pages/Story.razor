@page "/story/{Id:guid}"
@inject NarratorWorkspace Workspace
@inject ImportExportService ImportExport

<header><p class="eyebrow">Interactive story</p><h1>@_story?.Label</h1>@if (_story is not null) { <button class="button" @onclick="Export">Export story</button> }</header>
@if (_turns is null) { <p>Loading story…</p> } else { <details class="editor-card"><summary>Story memory and current plans</summary><label>Story summary<textarea @bind="_summary"></textarea></label><button class="button" @onclick="SaveSummary">Save summary</button><h3>Current Story Bible</h3><ul>@foreach (var item in _story!.CurrentStoryBible.Entries) { <li><strong>@item.Name:</strong> @string.Join("; ", item.KnownFacts)</li> }</ul><h3>Planned events</h3><ul>@foreach (var item in _story.CurrentPlannedEvents.Entries) { <li>@item.Description @if (!string.IsNullOrWhiteSpace(item.Condition)) { <em>— when: @item.Condition</em> }</li> }</ul></details><section class="transcript">@foreach (var turn in _turns) { <article class="turn"><p>@turn.Narration</p>@if (turn.SuggestedActions.Count > 0) { <div class="chips">@foreach (var action in turn.SuggestedActions) { <button @onclick="() => _action = action">@action</button> }</div>}</article> }</section><form @onsubmit="Play" @onsubmit:preventDefault="true"><textarea @bind="_action" placeholder="What do you do next?"></textarea><button class="button primary" disabled="@_busy">@(_busy ? "Writing…" : "Continue")</button></form> }
@code { [Parameter] public Guid Id { get; set; } private StoryState? _story; private IReadOnlyList<StoryTurn>? _turns; private string _action = ""; private string _summary = ""; private bool _busy; protected override async Task OnParametersSetAsync() { _story = await Workspace.StoryAsync(Id); _turns = await Workspace.TurnsAsync(Id); _summary = _story?.StorySummary ?? ""; } private async Task Play() { if (string.IsNullOrWhiteSpace(_action)) return; _busy = true; try { await Workspace.PlayAsync(Id, _action); _action = ""; await OnParametersSetAsync(); } finally { _busy = false; } } private async Task SaveSummary() { await Workspace.SaveStorySummaryAsync(Id, _summary); _story = await Workspace.StoryAsync(Id); } private Task Export() => _story is null ? Task.CompletedTask : ImportExport.ExportStoryAsync(_story); }
