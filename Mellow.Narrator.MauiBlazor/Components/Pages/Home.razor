@page "/"
@inject NarratorWorkspace Workspace

<header><p class="eyebrow">Your story desk</p><h1>Pick up where imagination left off.</h1><p class="lead">Create a definition, configure a model, and play without leaving the app.</p><p class="hint">Hybrid build marker: <strong>2026-08-14-events-v2</strong></p></header>
<section class="actions"><a class="button primary" href="definitions">New story definition</a><a class="button" href="stories">Continue a story</a></section>
@if (_loading) { <p>Loading your library…</p> } else { <section class="metrics"><article><strong>@_definitions</strong><span>Story definitions</span></article><article><strong>@_stories</strong><span>Active stories</span></article><article><strong>@_connections</strong><span>Saved connections</span></article></section> }

@code {
  private bool _loading = true; private int _definitions, _stories, _connections;
  protected override async Task OnInitializedAsync() { _definitions = (await Workspace.DefinitionsAsync()).Count; _stories = (await Workspace.StoriesAsync()).Count; _connections = (await Workspace.SettingsAsync()).Connections.Count; _loading = false; }
}
