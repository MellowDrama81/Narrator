<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NarratorRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..'))</NarratorRepositoryRoot>
    <PromptGeneratorProject>$(NarratorRepositoryRoot)\tools\Mellow.Narrator.PromptGenerator\Mellow.Narrator.PromptGenerator.csproj</PromptGeneratorProject>
    <GeneratedPromptSource>$(MSBuildProjectDirectory)\Generated\PromptTemplates.g.cs</GeneratedPromptSource>
  </PropertyGroup>

  <ItemGroup>
    <PromptGeneratorInput Include="$(NarratorRepositoryRoot)\prompts\manifest.json" />
    <PromptGeneratorInput Include="$(NarratorRepositoryRoot)\prompts\*.md" />
    <PromptGeneratorInput Include="$(PromptGeneratorProject)" />
    <PromptGeneratorInput Include="$(NarratorRepositoryRoot)\tools\Mellow.Narrator.PromptGenerator\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <Target
    Name="GeneratePromptTemplates"
    BeforeTargets="BeforeCompile"
    Inputs="@(PromptGeneratorInput)"
    Outputs="$(GeneratedPromptSource)"
    Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="dotnet run --project &quot;$(PromptGeneratorProject)&quot; -- --root &quot;$(NarratorRepositoryRoot)&quot; --target csharp" />
  </Target>

</Project>
