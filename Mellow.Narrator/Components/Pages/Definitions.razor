@page "/definitions"
@inject NarratorWorkspace Workspace
@inject NavigationManager Navigation
@inject ImportExportService ImportExport
@inject IJSRuntime JS
@inject HybridWorkspace HybridWorkspace

<header><p class="eyebrow">Story design</p><h1>Story definitions</h1></header>
@if (_items is null) { <p>Loading definitions...</p> } else if (_items.Count == 0) { <div class="empty">No definitions yet. Start with a blank canvas or generate one from a prompt.</div> } else { <section class="cards">@for (var index = 0; index < _items.Count; index++) { var item = _items[index]; var position = index; <article><h2>@item.Title</h2>@if (!string.IsNullOrWhiteSpace(item.Description)) { <p>@item.Description</p> }<p>@item.UpdatedAtUtc.ToLocalTime().ToString("g")</p><div class="actions"><button class="button primary" disabled="@_busy" @onclick="() => Start(item.Id)">Start story</button><a class="button" href="definition/@item.Id">Open</a><button class="button" disabled="@(position == 0 || _busy)" @onclick="() => Move(position, -1)">Earlier</button><button class="button" disabled="@(position == _items.Count - 1 || _busy)" @onclick="() => Move(position, 1)">Later</button><button class="button danger" disabled="@_busy" @onclick="() => Delete(item.Id)">Trash</button></div></article> }</section> }
<section class="editor-card"><p class="lead">Create a blank definition or describe every aspect of a story for the generator to organise.</p><h2>Generate a definition</h2><input @bind="_generatedTitle" @bind:after="SaveDraft" placeholder="Optional working title" /><textarea @bind="_generationPrompt" @bind:after="SaveDraft" placeholder="Story Definition Prompt - premise, characters, tone, starting state, future events, Story Bible and outcomes."></textarea><div class="actions"><button class="button primary" @onclick="Generate" disabled="@_busy">@(_busy ? "Generating..." : "Generate Story Definition")</button><button class="button" @onclick="Create" disabled="@_busy">Blank definition</button><button class="button" @onclick="Import">Import definition</button></div>@if (_error is not null) { <p class="error">@_error</p> }</section>
@code { private IReadOnlyList<StoryDefinitionSummary>? _items; private string _generatedTitle = "", _generationPrompt = ""; private string? _error; private bool _busy; protected override async Task OnInitializedAsync() { await HybridWorkspace.InitializeAsync(); var draft = HybridWorkspace.StoryPromptDraft; if (draft is not null) { _generatedTitle = draft.Title; _generationPrompt = draft.StoryPrompt; } await Refresh(); } private Task SaveDraft() => HybridWorkspace.SaveStoryPromptDraftAsync(new(null, _generatedTitle, _generationPrompt)); private async Task Refresh() => _items = await Workspace.DefinitionsAsync(); private async Task Create() { var item = await Workspace.CreateBlankDefinitionAsync(string.IsNullOrWhiteSpace(_generatedTitle) ? "Untitled story" : _generatedTitle); Navigation.NavigateTo($"definition/{item.Id}"); } private async Task Generate() { if (string.IsNullOrWhiteSpace(_generationPrompt)) { _error = "Enter a Story Definition Prompt first."; return; } _busy = true; _error = null; var targetId = Guid.NewGuid(); try { await HybridWorkspace.BeginAsync(TabType.StoryPrompt, targetId, PendingOperationType.GenerateStoryDefinition); var item = await Workspace.GenerateDefinitionAsync(new(null, _generatedTitle, _generationPrompt), false, targetId); Navigation.NavigateTo($"definition/{item.Id}"); } catch (Exception ex) { _error = ex.Message; } finally { await HybridWorkspace.CompleteAsync(TabType.StoryPrompt, targetId); _busy = false; } } private async Task Start(Guid id) { _busy = true; _error = null; try { var definition = await Workspace.DefinitionAsync(id) ?? throw new InvalidOperationException("Story Definition not found."); var result = await Workspace.StartAsync(new(id, new(definition.Title, definition.StoryPrompt, definition.InitialEventsPrompt, definition.InitialStoryBible, definition.InitialPlannedEvents, definition.InitialVictoryConditions, definition.InitialLossConditions)), Guid.NewGuid()); Navigation.NavigateTo($"story/{result.State.Id}"); } catch (Exception ex) { _error = ex.Message; } finally { _busy = false; } } private async Task Delete(Guid id) { if (!await JS.InvokeAsync<bool>("confirm", "Move this Story Definition to Trash? Existing stories remain playable.")) return; await Workspace.DeleteDefinitionAsync(id); await Refresh(); } private async Task Move(int index, int delta) { if (_items is null || index + delta < 0 || index + delta >= _items.Count) return; await Workspace.SwapDefinitionOrderAsync(_items[index].Id, _items[index + delta].Id); await Refresh(); } private async Task Import() { try { var item = await ImportExport.ImportDefinitionAsync(); if (item is not null) Navigation.NavigateTo($"definition/{item.Id}"); } catch (Exception ex) { _error = ex.Message; } } }
