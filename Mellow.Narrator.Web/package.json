{
  "name": "mellow.narrator.web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prompts:generate": "dotnet run --project ../tools/Mellow.Narrator.PromptGenerator -- --root .. --target typescript",
    "prompts:check": "dotnet run --project ../tools/Mellow.Narrator.PromptGenerator -- --root .. --target all --check",
    "prestart": "pnpm prompts:generate",
    "prebuild": "pnpm prompts:generate",
    "prebuild:github-pages": "pnpm prompts:generate",
    "pretest": "pnpm prompts:generate",
    "start": "ng serve",
    "build": "ng build && node scripts/prepare-hosting.mjs",
    "build:github-pages": "ng build --base-href /Narrator/ && node scripts/prepare-github-pages.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "dependencies": {
    "@angular/animations": "^22.0.6",
    "@angular/cdk": "^22.0.6",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/material": "^22.0.6",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
